SERVER_PORT=8080
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_FAST=deepseek-v4-flash
DEEPSEEK_MODEL_HEAVY=deepseek-v4-pro
DATABASE_PATH=./data/lifesim.db
TIMELINE_STEP_YEARS=3
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 鉴权（本地开发可设 AUTH_ENABLED=false 跳过）
AUTH_ENABLED=false
JWT_SECRET=change-me-to-a-long-random-string
SITE_ACCESS_CODE=your-gate-password
AUTH_BOOTSTRAP_USERS=alice:pass1,bob:pass2,carol:pass3
AUTH_ACCESS_TTL=2h
AUTH_REFRESH_TTL=720h
AUTH_GATE_TTL=24h
AUTH_RATE_LIMIT=5
AUTH_COOKIE_SECURE=false
